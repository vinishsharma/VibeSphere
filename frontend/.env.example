# Local development can omit these values: Vite will proxy API calls to localhost:8080.
# In Vercel, set both values to the public URL of your persistent backend service.
VITE_API_URL=https://api.example.com
VITE_SOCKET_URL=https://api.example.com

# Public Google OAuth client ID. Configure the matching JavaScript origin in Google Cloud.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

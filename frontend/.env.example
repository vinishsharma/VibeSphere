# Local development can omit these values: Vite will proxy API calls to localhost:8080.
# In Vercel, set VITE_API_URL to the public URL of your persistent backend service.
VITE_API_URL=https://api.example.com
# Optional: defaults to VITE_API_URL when omitted.
VITE_SOCKET_URL=https://api.example.com

# Optional public Google OAuth client ID. The app includes a safe fallback, but
# configure the matching JavaScript origin in Google Cloud for your Vercel domain.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
